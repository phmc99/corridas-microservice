  "item": [
    {
      "name": "1. Fluxo feliz",
      "item": [
        {
          "name": "Criar corrida (passageiro 1)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPassageiro1}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "postman-fluxo-feliz"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/corridas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "corridas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origem\": \"Centro\",\n  \"destino\": \"Barra da Tijuca\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"corridaId\", pm.response.json().id);",
                  "pm.test(\"corrida SOLICITADA\", () => pm.expect(pm.response.json().status).to.eql(\"SOLICITADA\"));"
                ]
              }
            }
          ]
        },
