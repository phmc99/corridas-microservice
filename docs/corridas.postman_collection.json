    {
      "name": "2. Idempotência",
      "item": [
        {
          "name": "Criar corrida com Idempotency-Key",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPassageiro1}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/corridas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "corridas"
              ]
            },
            "description": "Gera uma chave nova a cada execução e guarda em idempotencyKey.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origem\": \"Centro\",\n  \"destino\": \"Barra da Tijuca\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"corridaIdempotente\", pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotencyKey\", `chave-${Date.now()}`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir com a mesma chave (não duplica)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPassageiro1}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/corridas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "corridas"
              ]
            },
            "description": "Mesma chave da requisição anterior: devolve a corrida original com 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origem\": \"Centro\",\n  \"destino\": \"Barra da Tijuca\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mesma corrida\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"corridaIdempotente\"))));"
                ]
              }
            }
          ]
        }
      ]
    },
